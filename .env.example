# Copy this file to .env and fill in real values. .env is gitignored — never commit real keys.

# OpenAI-compatible base URL for your LiteLLM (or other) gateway.
DOCSTRUCT_BASE_URL=https://ai-gateway.mohaymen.ir/v1

# API key for the gateway above.
DOCSTRUCT_API_KEY=sk-...

# Model id as listed by the gateway's /v1/models endpoint.
DOCSTRUCT_MODEL=openai/gpt-4o
